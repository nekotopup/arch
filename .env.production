APP_NAME="Arch Topup"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-app-name.onrender.com

# Database (SQLite for simplicity on free tier)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Cache & session (file-based, more reliable on Render)
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Logging to stderr (Render captures this)
LOG_CHANNEL=stderr

# Mail (disabled for now; use SendGrid/etc. later)
MAIL_MAILER=log

# Storage
FILESYSTEM_DISK=local

# Disable features requiring persistent database
BROADCAST_CONNECTION=log
